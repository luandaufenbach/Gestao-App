# Copie para .env e preencha. O .env real nunca é versionado.

# Endereço da API. Lido em tempo de BUILD pelo Vite: alterar exige rebuild.
# Vazio equivale a http://localhost:3000 (ver src/services/http.js).
VITE_API_URL=http://localhost:3000

# ── Analytics de funil ──────────────────────────────────────
# Chave de projeto do PostHog. VAZIA = desligado: nenhuma chamada de rede e
# nenhum identificador guardado, que é o padrão em desenvolvimento — tráfego
# de teste não suja o funil de produção.
# Lida em tempo de BUILD pelo Vite: alterar exige rebuild.
VITE_POSTHOG_KEY=
# Padrão: https://us.i.posthog.com. Use https://eu.i.posthog.com para manter os
# dados na União Europeia.
VITE_POSTHOG_HOST=
