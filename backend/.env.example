# Copie para .env e preencha. O .env real nunca é versionado.

# ── Obrigatórias ────────────────────────────────────────────
# O boot falha se faltar qualquer uma destas duas (ver src/config/env.js).

# String de conexão do MongoDB. Local ou Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/gestao_financeira

# Mínimo de 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Opcionais ───────────────────────────────────────────────

# development | production | test
NODE_ENV=development

# Porta da API. Padrão: 3000.
PORT=3000

# Validade do token. Aceita o formato do jsonwebtoken (7d, 12h, 30m).
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS, separadas por vírgula. Precisa bater exatamente
# com o endereço do frontend, incluindo o protocolo e a porta.
CORS_ORIGINS=http://localhost:5173

# Endereço público do frontend. É a base dos links enviados por e-mail — o de
# recuperação de senha vira APP_URL + /reset-password?token=... Em produção,
# aponte para o domínio real ou o link do e-mail levará a localhost.
# Padrão: http://localhost:5173
APP_URL=http://localhost:5173

# ── E-mail transacional ─────────────────────────────────────
# VAZIO = modo desenvolvimento: nada é enviado, o link de recuperação só é
# escrito no console do servidor. Dá para testar o fluxo inteiro assim,
# copiando o link do terminal.
#
# Para enviar de verdade, preencha as três e implemente o provedor no
# PONTO DE EXTENSÃO de src/utils/mailer.js (Resend, SES, SMTP...).
# Valor pretendido: resend | ses | smtp
MAIL_PROVIDER=
MAIL_API_KEY=
# Remetente, no formato "Nome <endereco@dominio>". O domínio precisa estar
# verificado no provedor, ou o e-mail cai em spam.
MAIL_FROM=

# Servidores DNS a forçar no resolvedor do Node, separados por vírgula.
# Só é necessário se a conexão com o Atlas falhar com querySrv ECONNREFUSED,
# o que acontece em algumas máquinas Windows. Vazio = comportamento padrão.
DNS_SERVERS=

# ── Monitoramento de erro ───────────────────────────────────
# DSN do projeto no Sentry. VAZIO = desligado: nenhuma chamada de rede, que é
# o padrão em desenvolvimento e em teste. Com DSN preenchido, todo erro que
# vira 500 chega notificado com stack e com o id do usuário afetado.
# O corpo da requisição e o cabeçalho Authorization nunca são enviados
# (ver o beforeSend em src/config/monitoring.js).
SENTRY_DSN=

# ── Paywall ─────────────────────────────────────────────────
# true liga a cobrança nos recursos pagos (projeção e relatórios). Qualquer
# outro valor, inclusive vazio, deixa tudo aberto — que é o padrão enquanto
# não existe forma de pagar. Ver backend/src/middlewares/requirePaidPlan.js.
PAYWALL_ENABLED=
